{
  "$schema": "https://biomejs.dev/schemas/2.2.5/schema.json",
  "javascript": {
    "formatter": {
      "enabled": true,
      "lineWidth": 90,
      "bracketSpacing": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "lineEnding": "lf",
      "indentStyle": "space",
      "indentWidth": 2
    }
  }
}
